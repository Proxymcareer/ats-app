# Copy this file to .env for local development.
# In production (Render), these are set as environment variables in the dashboard
# instead of a .env file.

# Postgres connection string. Render provides this automatically when you
# attach the ats-db database defined in render.yaml.
DATABASE_URL=postgres://localhost:5432/ats_dev

# Set to "true" only if your Postgres requires SSL (Render's managed Postgres does).
PGSSL=false

# The one admin account that can log in to /admin.
# Change the password after first login is not supported yet -- for now,
# change these env vars and redeploy to rotate credentials.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now

# Long random string used to sign session cookies. Render can auto-generate
# this for you (see render.yaml). For local dev, any random string works.
SESSION_SECRET=dev-only-secret-change-me

PORT=3000
